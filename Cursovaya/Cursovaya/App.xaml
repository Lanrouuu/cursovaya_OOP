<Application x:Class="Cursovaya.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Cursovaya.Views"
             xmlns:vm="clr-namespace:Cursovaya.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="/Resources/Languages/Strings.ru-RU.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
                <views:RegisterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdvertisementsViewModel}">
                <views:AdvertisementsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdvertisementDetailsViewModel}">
                <views:AdvertisementDetailsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AddEditAdvertisementViewModel}">
                <views:AddEditAdvertisementView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                <views:ProfileView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdminPanelViewModel}">
                <views:AdminPanelView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
