<UserControl x:Class="Cursovaya.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Cursovaya.Helpers">
    <Grid>
        <Border Style="{StaticResource CardBorderStyle}"
                MaxWidth="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="36">
            <StackPanel>
                <Border Width="56"
                        Height="56"
                        CornerRadius="14"
                        Background="{DynamicResource AccentLightBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <TextBlock Text="TA"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="{DynamicResource NavRegister}"
                           Style="{StaticResource SectionTitleStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource RegisterSubtitle}"
                           Style="{StaticResource PageSubtitleStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,10,14">
                        <TextBlock Text="{DynamicResource UserName}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WatermarkTextBoxStyle}"
                                 Tag="{DynamicResource UserNamePlaceholder}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Phone}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WatermarkTextBoxStyle}"
                                 Tag="{DynamicResource PhonePlaceholder}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Email}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WatermarkTextBoxStyle}"
                                 Tag="{DynamicResource EmailPlaceholder}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,10,0">
                        <TextBlock Text="{DynamicResource Password}" Style="{StaticResource FieldLabelStyle}"/>
                        <PasswordBox Style="{StaticResource WatermarkPasswordBoxStyle}"
                                     h:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{DynamicResource PasswordPlaceholder}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="{DynamicResource ConfirmPassword}" Style="{StaticResource FieldLabelStyle}"/>
                        <PasswordBox Style="{StaticResource WatermarkPasswordBoxStyle}"
                                     h:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{DynamicResource ConfirmPasswordPlaceholder}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                           Margin="4,14,4,0"
                           FontSize="13"/>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{DynamicResource NavLogin}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenLoginCommand}"
                            Margin="2,0"/>
                    <Button Content="{DynamicResource NavRegister}"
                            Command="{Binding RegisterCommand}"
                            Grid.Column="1"
                            Margin="2,0"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
