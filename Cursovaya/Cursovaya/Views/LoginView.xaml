<UserControl x:Class="Cursovaya.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Cursovaya.Helpers">
    <Grid>
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="36">
                <StackPanel>
                    <!-- Icon -->
                    <Border Width="56"
                            Height="56"
                            CornerRadius="14"
                            Background="{DynamicResource AccentLightBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <TextBlock Text="TA"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{DynamicResource NavLogin}"
                               Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource LoginSubtitle}"
                               Style="{StaticResource PageSubtitleStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <TextBlock Text="{DynamicResource Email}"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WatermarkTextBoxStyle}"
                             Tag="{DynamicResource EmailPlaceholder}"/>

                    <TextBlock Text="{DynamicResource Password}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="4,14,4,6"/>
                    <PasswordBox Style="{StaticResource WatermarkPasswordBoxStyle}"
                                 h:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{DynamicResource PasswordPlaceholder}"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                               Margin="4,14,4,0"
                               FontSize="13"/>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="{DynamicResource NavLogin}"
                                Command="{Binding LoginCommand}"
                                Grid.Column="0"
                                Margin="2,0"/>
                        <Button Content="{DynamicResource NavRegister}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenRegisterCommand}"
                                Grid.Column="1"
                                Margin="2,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
