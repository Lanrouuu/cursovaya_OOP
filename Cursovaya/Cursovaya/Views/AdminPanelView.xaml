<UserControl x:Class="Cursovaya.Views.AdminPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Cursovaya.Views">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource NavAdmin}" Style="{StaticResource SectionTitleStyle}"
                       Margin="4,0,4,2"/>
            <TextBlock Text="{DynamicResource AdminSubtitle}"
                       Style="{StaticResource PageSubtitleStyle}"
                       Margin="4,0,4,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="{DynamicResource Users}">
                <DockPanel Margin="8">
                    <Button Content="{DynamicResource ExportUsers}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DataContext.ExportUsersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            DockPanel.Dock="Top"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,10"/>
                    <views:UsersManagementView DataContext="{Binding UsersViewModel}"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="{DynamicResource Advertisements}">
                <DockPanel Margin="8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBox Width="240"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource Search}"/>
                        <ComboBox Width="170"
                                  ItemsSource="{Binding StatusValues}"
                                  SelectedItem="{Binding SelectedStatus}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="{DynamicResource Clear}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearFilterCommand}"/>
                        <Button Content="{DynamicResource Activate}" Command="{Binding SetActiveCommand}"/>
                        <Button Content="{DynamicResource Hide}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding HideCommand}"/>
                        <Button Content="{DynamicResource Block}"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding BlockCommand}"/>
                        <Button Content="{DynamicResource Delete}"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteCommand}"/>
                        <Button Content="{DynamicResource ExportAdvertisements}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ExportAdvertisementsCommand}"
                                Margin="16,0,0,0"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Advertisements}"
                              SelectedItem="{Binding SelectedAdvertisement}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="{DynamicResource Title}" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="{DynamicResource Price}" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource Category}" Binding="{Binding Category.Name}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource Seller}" Binding="{Binding User.UserName}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource City}" Binding="{Binding City}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource Status}" Binding="{Binding Status, Converter={StaticResource EnumToStringConverter}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{DynamicResource Categories}">
                <views:CategoriesView DataContext="{Binding CategoriesViewModel}" Margin="8"/>
            </TabItem>

            <TabItem Header="{DynamicResource AdminLogs}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource AdminLogsHint}"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="4,0,4,10"/>
                    <DataGrid ItemsSource="{Binding AppLogs}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource LogDate}"
                                                Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                                Width="160"/>
                            <DataGridTextColumn Header="{DynamicResource LogAction}"
                                                Binding="{Binding Action}"
                                                Width="120"/>
                            <DataGridTextColumn Header="{DynamicResource LogDescription}"
                                                Binding="{Binding Description}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Admin Id"
                                                Binding="{Binding AdminUserId}"
                                                Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
