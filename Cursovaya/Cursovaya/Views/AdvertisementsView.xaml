<UserControl x:Class="Cursovaya.Views.AdvertisementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:userControls="clr-namespace:Cursovaya.UserControls">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{DynamicResource Advertisements}"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="4,0,4,2"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="4,0,4,0">
                    <Run Text="{DynamicResource ResultsFound}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding Advertisements.Count, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{DynamicResource AddAdvertisement}"
                    Command="{Binding AddAdvertisementCommand}"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    MinWidth="200"
                    Padding="20,9"/>
        </Grid>

        <!-- Filters -->
        <userControls:SearchFilterControl Grid.Row="1"/>

        <!-- Advertisements list -->
        <Grid Grid.Row="2">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                       Margin="4"/>

            <!-- Empty state -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="48,40"
                    CornerRadius="20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Advertisements.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="80" Height="80" CornerRadius="20"
                            Background="{DynamicResource AccentLightBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="📋" FontSize="36"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource NoAdvertisements}"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource NoAdvertisementsHint}"
                               Style="{StaticResource PageSubtitleStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <DockPanel>
                <!-- Pagination -->
                <Border DockPanel.Dock="Bottom"
                        Margin="0,12,0,0"
                        Visibility="{Binding ShowPagination, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="←"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding PreviousPageCommand}"
                                MinWidth="40"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding PageInfo}"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <Button Content="→"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding NextPageCommand}"
                                MinWidth="40"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0">
                    <ItemsControl ItemsSource="{Binding Advertisements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                 <userControls:AdvertisementCardControl
                                     Title="{Binding Title}"
                                     ShortDescription="{Binding ShortDescription}"
                                     Price="{Binding Advertisement.Price}"
                                     ImagePath="{Binding Advertisement.ImagePath}"
                                     City="{Binding City}"
                                     Status="{Binding Advertisement.Status}"
                                     Condition="{Binding Condition}"
                                     ViewCount="{Binding ViewCount}"
                                     FavoritesCount="{Binding FavoritesCount}"
                                     CategoryName="{Binding CategoryName}"
                                     SellerName="{Binding SellerName}"
                                    CreatedAt="{Binding Advertisement.CreatedAt}"
                                    IsFavorite="{Binding IsFavorite}"
                                    ToggleFavoriteCommand="{Binding ToggleFavoriteCommand}"
                                    OpenCommand="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    OpenCommandParameter="{Binding Advertisement}"
                                    EditCommand="{Binding DataContext.EditAdvertisementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    EditCommandParameter="{Binding Advertisement}"
                                    DeleteCommand="{Binding DataContext.DeleteAdvertisementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    DeleteCommandParameter="{Binding Advertisement}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
