<UserControl x:Class="Cursovaya.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Cursovaya.Helpers"
             xmlns:models="clr-namespace:Cursovaya.Models">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource NavProfile}"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="4,0,4,2"/>
            <TextBlock Text="{DynamicResource ProfileSubtitle}"
                       Style="{StaticResource PageSubtitleStyle}"
                       Margin="4,0,4,0"/>
        </StackPanel>

        <!-- Profile cards row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Profile info -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0"
                    Padding="18"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="52"
                            Height="52"
                            CornerRadius="26"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Top"
                            Effect="{StaticResource ButtonShadow}">
                        <TextBlock Text="{Binding UserName, Converter={StaticResource InitialsConverter}}"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource ProfileUserBlock}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource UserName}" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Phone}" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{DynamicResource PhonePlaceholder}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Email}" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                   Margin="0,0,0,6"
                                   FontSize="12"/>

                        <Button Content="{DynamicResource Save}"
                                Command="{Binding SaveProfileCommand}"
                                HorizontalAlignment="Left"
                                MinWidth="120"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Password + activity -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ChangePassword}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource CurrentPassword}" Style="{StaticResource FieldLabelStyle}"/>
                            <PasswordBox Style="{StaticResource WatermarkPasswordBoxStyle}"
                                         h:PasswordBoxHelper.BoundPassword="{Binding CurrentPassword, Mode=TwoWay}"
                                         Tag="{DynamicResource PasswordPlaceholder}"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{DynamicResource NewPassword}" Style="{StaticResource FieldLabelStyle}"/>
                                <PasswordBox Style="{StaticResource WatermarkPasswordBoxStyle}"
                                             h:PasswordBoxHelper.BoundPassword="{Binding NewPassword, Mode=TwoWay}"
                                             Tag="{DynamicResource PasswordPlaceholder}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="{DynamicResource ConfirmNewPassword}" Style="{StaticResource FieldLabelStyle}"/>
                                <PasswordBox Style="{StaticResource WatermarkPasswordBoxStyle}"
                                             h:PasswordBoxHelper.BoundPassword="{Binding ConfirmNewPassword, Mode=TwoWay}"
                                             Tag="{DynamicResource ConfirmPasswordPlaceholder}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding PasswordErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding PasswordErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                   Margin="4,0,4,0"
                                   FontSize="12"/>
                        <Button Content="{DynamicResource ChangePassword}"
                                Command="{Binding ChangePasswordCommand}"
                                HorizontalAlignment="Left"
                                MinWidth="180"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Activity}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{DynamicResource AccentLightBrush}"
                                    CornerRadius="10"
                                    Padding="10,8"
                                    Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding MyAdvertisements.Count, Mode=OneWay}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MyAdvertisements}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource AccentLightBrush}"
                                    CornerRadius="10"
                                    Padding="10,8"
                                    Margin="6,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding FavoriteAdvertisements.Count, Mode=OneWay}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource MyFavorites}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{DynamicResource ProfileAdsHint}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11"
                                   LineHeight="15"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- My Advertisements table + Favorites -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock Text="{DynamicResource MyAdvertisements}"
                           FontSize="20"
                           FontWeight="Bold"
                           DockPanel.Dock="Top"
                           Margin="0,0,0,14"/>
                        <DataGrid ItemsSource="{Binding MyAdvertisements}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Title}" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="{DynamicResource Price}" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Category}" Binding="{Binding Category.Name}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource City}" Binding="{Binding City}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Status}" Binding="{Binding Status, Converter={StaticResource EnumToStringConverter}}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource ExpiresAt}" Binding="{Binding ExpiresAt, StringFormat={}{0:dd.MM.yyyy}}" Width="*"/>
                                <DataGridTemplateColumn Header="{DynamicResource Edit}" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{DynamicResource Edit}"
                                            Style="{StaticResource SmallSecondaryButtonStyle}"
                                            Command="{Binding DataContext.EditAdvertisementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource Renew}" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{DynamicResource Renew}"
                                            Command="{Binding DataContext.RenewAdvertisementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:AdvertisementStatus.Hidden}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Favorites -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource MyFavorites}"
                           FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>

                        <!-- Empty state -->
                        <TextBlock Text="{DynamicResource NoFavorites}"
                           FontSize="14"
                           Margin="4,0,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FavoriteAdvertisements.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <DataGrid ItemsSource="{Binding FavoriteAdvertisements}">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FavoriteAdvertisements.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Title}" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="{DynamicResource Price}" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Category}" Binding="{Binding Category.Name}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource City}" Binding="{Binding City}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Seller}" Binding="{Binding User.UserName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
