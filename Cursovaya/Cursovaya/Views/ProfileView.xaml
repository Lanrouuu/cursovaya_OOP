<UserControl x:Class="Cursovaya.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource NavProfile}"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="4,0,4,2"/>
            <TextBlock Text="{DynamicResource ProfileSubtitle}"
                       Style="{StaticResource PageSubtitleStyle}"
                       Margin="4,0,4,0"/>
        </StackPanel>

        <!-- Profile cards row -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <!-- Profile info -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="64"
                            Height="64"
                            CornerRadius="16"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="USER"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource ProfileUserBlock}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,10,12">
                                <TextBlock Text="{DynamicResource UserName}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Phone}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Email}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                                   Margin="4,0,4,8"
                                   FontSize="13"/>

                        <Button Content="{DynamicResource Save}"
                                Command="{Binding SaveProfileCommand}"
                                HorizontalAlignment="Left"
                                MinWidth="140"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Interface settings -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource InterfaceSettings}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="{DynamicResource Theme}" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}"
                              Margin="4,0,4,16"/>

                    <TextBlock Text="{DynamicResource Language}" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="Title"
                              Margin="4,0,4,16"/>

                    <Border Background="{DynamicResource AccentLightBrush}"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="4,4,4,0">
                        <TextBlock Text="{DynamicResource SettingsHint}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Activity stats -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Activity}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,16"/>
                    <Border Background="{DynamicResource AccentLightBrush}"
                            CornerRadius="12"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding MyAdvertisements.Count, Mode=OneWay}"
                                       Style="{StaticResource StatNumberStyle}"/>
                            <TextBlock Text="{DynamicResource MyAdvertisements}"
                                       Style="{StaticResource MutedTextStyle}"
                                       FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{DynamicResource ProfileAdsHint}"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="13"
                               LineHeight="20"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- My Advertisements table -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0">
            <DockPanel>
                <TextBlock Text="{DynamicResource MyAdvertisements}"
                           FontSize="20"
                           FontWeight="Bold"
                           DockPanel.Dock="Top"
                           Margin="0,0,0,14"/>
                <DataGrid ItemsSource="{Binding MyAdvertisements}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Title}" Binding="{Binding Title}" Width="2*"/>
                        <DataGridTextColumn Header="{DynamicResource Price}" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Category}" Binding="{Binding Category.Name}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource City}" Binding="{Binding City}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Status}" Binding="{Binding Status, Converter={StaticResource EnumToStringConverter}}" Width="*"/>
                        <DataGridTemplateColumn Header="{DynamicResource Edit}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{DynamicResource Edit}"
                                            Style="{StaticResource SmallSecondaryButtonStyle}"
                                            Command="{Binding DataContext.EditAdvertisementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
