<UserControl x:Class="Cursovaya.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DataGrid ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="{DynamicResource Title}" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="{DynamicResource FullDescription}" Binding="{Binding Description}" Width="2*"/>
                <DataGridCheckBoxColumn Header="{DynamicResource IsActive}" Binding="{Binding IsActive}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="12,4,4,4">
            <StackPanel>
                <TextBlock Text="{DynamicResource Categories}" Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource AddEditSubtitle}"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="{DynamicResource Title}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{DynamicResource FullDescription}" Style="{StaticResource FieldLabelStyle}"
                           Margin="4,14,4,6"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MultilineTextBoxStyle}"/>
                <CheckBox Content="{DynamicResource IsActive}" IsChecked="{Binding IsActive}" Margin="4,10"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                           Margin="4,10,4,0"
                           FontSize="13"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Content="{DynamicResource AddAdvertisement}" Command="{Binding AddCommand}" Margin="2"/>
                    <Button Content="{DynamicResource Save}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding UpdateCommand}"
                            Grid.Column="1" Margin="2"/>
                    <Button Content="{DynamicResource Delete}"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DeleteCommand}"
                            Grid.Row="1" Margin="2"/>
                    <Button Content="{DynamicResource Clear}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearCommand}"
                            Grid.Row="1" Grid.Column="1" Margin="2"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
