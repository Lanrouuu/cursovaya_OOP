<UserControl x:Class="Cursovaya.Views.UsersManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataGrid ItemsSource="{Binding Users}"
              SelectedItem="{Binding SelectedUser}">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
            <DataGridTextColumn Header="{DynamicResource UserName}" Binding="{Binding UserName}" Width="2*"/>
            <DataGridTextColumn Header="{DynamicResource Email}" Binding="{Binding Email}" Width="2*"/>
            <DataGridTextColumn Header="{DynamicResource Phone}" Binding="{Binding PhoneNumber}" Width="*"/>
            <DataGridTextColumn Header="{DynamicResource Role}" Binding="{Binding Role, Converter={StaticResource EnumToStringConverter}}" Width="*"/>
            <DataGridCheckBoxColumn Header="{DynamicResource Blocked}" Binding="{Binding IsBlocked}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
