<UserControl x:Class="Cursovaya.Views.AddEditAdvertisementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Border Style="{StaticResource CardBorderStyle}"
                MaxWidth="800"
                HorizontalAlignment="Center"
                Margin="24,16"
                Padding="32">
            <StackPanel>
                <TextBlock Margin="0,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
                            <Setter Property="Text" Value="{DynamicResource NewAdvertisementTitle}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource EditAdvertisementTitle}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{DynamicResource AddEditSubtitle}"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,0,0,24"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Title}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{DynamicResource ShortDescription}" Style="{StaticResource FieldLabelStyle}" Margin="4,12,4,6"/>
                        <TextBox Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{DynamicResource FullDescription}" Style="{StaticResource FieldLabelStyle}" Margin="4,12,4,6"/>
                        <TextBox Text="{Binding FullDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MultilineTextBoxStyle}"/>
                        <TextBlock Text="{DynamicResource Price}" Style="{StaticResource FieldLabelStyle}" Margin="4,12,4,6"/>
                        <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{DynamicResource Category}" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource CategoryNameConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource Condition}" Style="{StaticResource FieldLabelStyle}" Margin="4,12,4,6"/>
                        <ComboBox ItemsSource="{Binding ConditionValues}"
                                  SelectedItem="{Binding Condition}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource City}" Style="{StaticResource FieldLabelStyle}" Margin="4,12,4,6"/>
                        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{DynamicResource Email}" Style="{StaticResource FieldLabelStyle}" Margin="4,12,4,6"/>
                        <TextBox Text="{Binding SellerContactEmail, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{DynamicResource Phone}" Style="{StaticResource FieldLabelStyle}" Margin="4,12,4,6"/>
                        <TextBox Text="{Binding SellerContactPhone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Image -->
                <Grid Margin="4,18,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ImageDropBorder"
                            Height="120"
                            CornerRadius="10"
                            ClipToBounds="True"
                            Background="{DynamicResource HoverBrush}"
                            AllowDrop="True"
                            Drop="ImageDropBorder_Drop"
                            DragOver="ImageDropBorder_DragOver"
                            Cursor="Hand"
                            ToolTip="{DynamicResource DragImageHint}">
                        <Grid>
                            <TextBlock Text="{DynamicResource DragImageHint}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="8"
                                       TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                                   Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button Content="{DynamicResource ChooseImage}"
                                Command="{Binding BrowseImageCommand}"
                                HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding ImagePath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="4,8,4,0"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="13"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                           Margin="4,16,4,0"
                           FontSize="13"/>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}" Margin="2,0"/>
                    <Button Content="{DynamicResource Cancel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Grid.Column="1"
                            Margin="2,0"/>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
