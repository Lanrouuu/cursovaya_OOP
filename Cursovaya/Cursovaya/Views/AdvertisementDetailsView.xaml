<UserControl x:Class="Cursovaya.Views.AdvertisementDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:userControls="clr-namespace:Cursovaya.UserControls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <DockPanel Margin="0,0,0,20">
                <Button Content="{DynamicResource Back}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BackCommand}"
                        DockPanel.Dock="Left"
                        HorizontalAlignment="Left"
                        MinWidth="100"/>
                <TextBlock Text="{DynamicResource DetailsPageTitle}"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Image -->
                <Border Style="{StaticResource CardBorderStyle}"
                        MinHeight="480"
                        Padding="0"
                        ClipToBounds="True"
                        Margin="0,8,12,8">
                    <Grid Background="{DynamicResource HoverBrush}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="76"
                                    Height="76"
                                    CornerRadius="12"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundBrush}">
                                <TextBlock Text="{DynamicResource Photo}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource NoImage}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"
                                       FontSize="13"/>
                        </StackPanel>
                        <Image Source="{Binding Advertisement.ImagePath, Converter={StaticResource ImagePathConverter}}"
                               Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <!-- Details -->
                <Border Grid.Column="1"
                        Style="{StaticResource CardBorderStyle}"
                        MinHeight="480"
                        Margin="8">
                    <StackPanel>
                        <TextBlock Text="{Binding Advertisement.Title, Mode=OneWay}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Advertisement.Price, StringFormat={}{0:N0} ₽, Mode=OneWay}"
                                   Style="{StaticResource PriceTextStyle}"
                                   FontSize="24"
                                   Margin="0,0,0,20"/>

                        <WrapPanel Margin="0,0,0,20">
                            <Border Style="{StaticResource TagStyle}">
                                <TextBlock Text="{Binding Advertisement.Category.Name, Mode=OneWay}" FontSize="13"/>
                            </Border>
                            <Border Style="{StaticResource TagStyle}">
                                <TextBlock Text="{Binding Advertisement.City, Mode=OneWay}" FontSize="13"/>
                            </Border>
                            <Border Style="{StaticResource TagStyle}">
                                <TextBlock Text="{Binding Advertisement.CreatedAt, StringFormat={}{0:dd.MM.yyyy}, Mode=OneWay}" FontSize="13"/>
                            </Border>
                            <Border Style="{StaticResource TagStyle}">
                                <TextBlock FontSize="13">
                                    <Run Text="{DynamicResource Condition}"/>
                                    <Run Text=": "/>
                                    <Run Text="{Binding Advertisement.Condition, Converter={StaticResource EnumToStringConverter}, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </WrapPanel>

                        <Separator/>
                        <TextBlock Text="{DynamicResource FullDescription}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Margin="0,14,0,10"/>
                        <TextBlock Text="{Binding Advertisement.FullDescription, Mode=OneWay}"
                                   FontSize="15"
                                   LineHeight="24"
                                   Margin="0,0,0,20"/>

                        <Button Content="{DynamicResource ShowContacts}"
                                Command="{Binding ShowContactsCommand}"
                                HorizontalAlignment="Left"
                                MinWidth="180"/>
                    </StackPanel>
                </Border>

                <!-- Seller info -->
                <StackPanel Grid.Column="2" Margin="8">
                    <userControls:ContactInfoControl
                        SellerName="{Binding Advertisement.User.UserName, Mode=OneWay}"
                        Email="{Binding Advertisement.SellerContactEmail, Mode=OneWay}"
                        PhoneNumber="{Binding Advertisement.SellerContactPhone, Mode=OneWay}"
                        ShowActionButton="False"
                        Visibility="{Binding ShowContacts, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Border Style="{StaticResource CardBorderStyle}"
                            Visibility="{Binding ShowContacts, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Seller}"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource AccentLightBrush}"
                                    CornerRadius="10"
                                    Padding="16,12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Advertisement.User.UserName, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{DynamicResource ContactsHidden}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="13"
                                               LineHeight="20"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
