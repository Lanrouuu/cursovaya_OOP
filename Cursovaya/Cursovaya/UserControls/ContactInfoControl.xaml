<UserControl x:Class="Cursovaya.UserControls.ContactInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commands="clr-namespace:Cursovaya.Commands"
             x:Name="Root">
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static commands:CustomCommands.ShowContactsCommand}"
                        Executed="ShowContactsCommand_Executed"/>
    </UserControl.CommandBindings>

    <Border Style="{StaticResource CardBorderStyle}" Margin="0">
        <StackPanel>
            <TextBlock Text="{DynamicResource Seller}"
                       FontWeight="Bold"
                       FontSize="18"
                       Margin="0,0,0,14"/>
            <Border Background="{DynamicResource AccentLightBrush}"
                    CornerRadius="10"
                    Padding="16,14"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding SellerName, ElementName=Root, Mode=OneWay}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,8"/>
                    <Separator Margin="0,0,0,8"/>
                    <TextBlock Margin="0,4,0,0" FontSize="14">
                        <Run Text="{DynamicResource Email}" FontWeight="SemiBold"/>
                        <Run Text=": "/>
                        <Run Text="{Binding Email, ElementName=Root, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" FontSize="14">
                        <Run Text="{DynamicResource Phone}" FontWeight="SemiBold"/>
                        <Run Text=": "/>
                        <Run Text="{Binding PhoneNumber, ElementName=Root, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Button Content="{DynamicResource ShowContacts}"
                    Command="{x:Static commands:CustomCommands.ShowContactsCommand}"
                    CommandTarget="{Binding ElementName=Root}"
                    Visibility="{Binding ShowActionButton, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
