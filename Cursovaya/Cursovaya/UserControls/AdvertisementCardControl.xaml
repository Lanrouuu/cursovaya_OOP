<UserControl x:Class="Cursovaya.UserControls.AdvertisementCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commands="clr-namespace:Cursovaya.Commands"
             xmlns:models="clr-namespace:Cursovaya.Models"
             x:Name="Root"
             MinWidth="540">
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static commands:CustomCommands.OpenAdvertisementCommand}"
                        Executed="OpenAdvertisementCommand_Executed"/>
    </UserControl.CommandBindings>

    <Border Style="{StaticResource AdvertisementCardBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- Image -->
            <Border Width="176"
                    Height="132"
                    CornerRadius="10"
                    Background="{DynamicResource HoverBrush}"
                    ClipToBounds="True"
                    HorizontalAlignment="Left"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{x:Static commands:CustomCommands.OpenAdvertisementCommand}"
                                  CommandTarget="{Binding ElementName=Root}"/>
                </Border.InputBindings>
                <Grid>
                    <TextBlock Text="{DynamicResource Photo}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                    <Image Source="{Binding ImagePath, ElementName=Root, Converter={StaticResource ImagePathConverter}}"
                           Stretch="UniformToFill"/>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Column="1" Margin="4,0,14,0">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               Style="{StaticResource CardTitleStyle}"
                               Cursor="Hand"
                               Foreground="{DynamicResource TextBrush}">
                        <TextBlock.InputBindings>
                            <MouseBinding Gesture="LeftClick"
                                          Command="{x:Static commands:CustomCommands.OpenAdvertisementCommand}"
                                          CommandTarget="{Binding ElementName=Root}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <!-- Status badge -->
                    <Border x:Name="StatusBadge" Grid.Column="1"
                            CornerRadius="6" Padding="8,3"
                            Margin="8,2,0,0" VerticalAlignment="Top"
                            Background="{DynamicResource SuccessBrush}">
                        <TextBlock x:Name="StatusText"
                                   Text="{Binding Status, ElementName=Root, Converter={StaticResource EnumToStringConverter}}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static models:AdvertisementStatus.Hidden}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static models:AdvertisementStatus.Blocked}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static models:AdvertisementStatus.Deleted}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Background" Value="{DynamicResource MutedTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding ShortDescription, ElementName=Root}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="14"
                           Margin="0,0,0,10"
                           MaxHeight="40"
                           LineHeight="20"/>

                <WrapPanel>
                    <Border Style="{StaticResource TagStyle}">
                        <TextBlock Text="{Binding CategoryName, ElementName=Root}" FontSize="13"/>
                    </Border>
                    <Border Style="{StaticResource TagStyle}">
                        <TextBlock Text="{Binding Condition, ElementName=Root, Converter={StaticResource EnumToStringConverter}}" FontSize="13"/>
                    </Border>
                    <Border Style="{StaticResource TagStyle}">
                        <TextBlock>
                            <Run Text="{DynamicResource Seller}"/>
                            <Run Text=": "/>
                            <Run Text="{Binding SellerName, ElementName=Root}"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource TagStyle}">
                        <TextBlock>
                            <Run Text="{Binding City, ElementName=Root}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding CreatedAt, ElementName=Root, StringFormat={}{0:dd.MM.yyyy}}"/>
                        </TextBlock>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Width="170">
                <TextBlock Text="{Binding Price, ElementName=Root, StringFormat={}{0:N0} ₽}"
                           Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PriceTextStyle}">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontSize" Value="22"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Price, ElementName=Root}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{DynamicResource Free}"
                           Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PriceTextStyle}">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontSize" Value="22"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Price, ElementName=Root}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Stats row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <TextBlock FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0">
                        <Run Text="👁"/>
                        <Run Text="{Binding ViewCount, ElementName=Root}"/>
                    </TextBlock>
                    <Button Command="{Binding ToggleFavoriteCommand, ElementName=Root}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="{DynamicResource FavoriteTooltip}">
                        <TextBlock FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite, ElementName=Root}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding IsFavorite, ElementName=Root, Converter={StaticResource BooleanToHeartConverter}}"/>
                            <Run Text="{Binding FavoritesCount, ElementName=Root}"/>
                        </TextBlock>
                    </Button>
                </StackPanel>

                <Button Content="{DynamicResource Details}"
                        Style="{StaticResource SmallButtonStyle}"
                        Command="{x:Static commands:CustomCommands.OpenAdvertisementCommand}"
                        CommandTarget="{Binding ElementName=Root}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,6"/>
                <Button Content="{DynamicResource Edit}"
                        Style="{StaticResource CardEditButtonStyle}"
                        Command="{Binding EditCommand, ElementName=Root}"
                        CommandParameter="{Binding EditCommandParameter, ElementName=Root}"
                        Margin="0,0,0,6"/>
                <Button Content="{DynamicResource Delete}"
                        Style="{StaticResource CardDeleteButtonStyle}"
                        Command="{Binding DeleteCommand, ElementName=Root}"
                        CommandParameter="{Binding DeleteCommandParameter, ElementName=Root}"
                        Margin="0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
