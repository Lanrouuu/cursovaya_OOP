<UserControl x:Class="Cursovaya.UserControls.SearchFilterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource SearchFilters}"
                       FontSize="17"
                       FontWeight="Bold"
                       Margin="4,0,4,16"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Style="{StaticResource FilterFieldPanelStyle}">
                    <TextBlock Text="{DynamicResource SearchQuery}" Style="{StaticResource FilterLabelStyle}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WatermarkTextBoxStyle}"
                             Tag="{DynamicResource SearchPlaceholder}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Style="{StaticResource FilterFieldPanelStyle}">
                    <TextBlock Text="{DynamicResource Category}" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Style="{StaticResource FilterFieldPanelStyle}">
                    <TextBlock Text="{DynamicResource PriceFrom}" Style="{StaticResource FilterLabelStyle}"/>
                    <TextBox Text="{Binding MinPriceText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WatermarkTextBoxStyle}"
                             Tag="{DynamicResource PriceFromPlaceholder}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Style="{StaticResource FilterFieldPanelStyle}">
                    <TextBlock Text="{DynamicResource PriceTo}" Style="{StaticResource FilterLabelStyle}"/>
                    <TextBox Text="{Binding MaxPriceText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WatermarkTextBoxStyle}"
                             Tag="{DynamicResource PriceToPlaceholder}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Style="{StaticResource FilterFieldPanelStyle}">
                    <TextBlock Text="{DynamicResource City}" Style="{StaticResource FilterLabelStyle}"/>
                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WatermarkTextBoxStyle}"
                             Tag="{DynamicResource CityPlaceholder}"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Style="{StaticResource FilterFieldPanelStyle}">
                    <TextBlock Text="{DynamicResource Condition}" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ConditionValues}"
                              SelectedItem="{Binding SelectedCondition}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="6" Style="{StaticResource FilterFieldPanelStyle}">
                    <TextBlock Text="{DynamicResource DateFrom}" Style="{StaticResource FilterLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding DateFrom}"/>
                </StackPanel>

                <StackPanel Grid.Column="7" Style="{StaticResource FilterFieldPanelStyle}">
                    <TextBlock Text="{DynamicResource Sort}" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}"
                              DisplayMemberPath="Title"/>
                </StackPanel>

                <StackPanel Grid.Column="8" Style="{StaticResource FilterFieldPanelStyle}" Margin="0">
                    <TextBlock Text=" " Style="{StaticResource FilterLabelStyle}"/>
                    <Button Content="{DynamicResource Clear}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearFiltersCommand}"
                            MinWidth="90"
                            Margin="4"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
