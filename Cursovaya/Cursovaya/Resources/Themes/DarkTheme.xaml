<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101725"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#182235"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#0B1120"/>
    <SolidColorBrush x:Key="HeaderPillBrush" Color="#223047"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B5C1D6"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#8BA0BD"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#263348"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#182235"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#34445C"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#111827"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#24324A"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#1D3557"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3677F2"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#450A0A"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#064E3B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="PriceBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#223047"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#34445C"/>
    <SolidColorBrush x:Key="GlassBrush" Color="#182235CC"/>
    <SolidColorBrush x:Key="NavigationActiveBrush" Color="#4F8CFF"/>
    <SolidColorBrush x:Key="NavigationHoverBrush" Color="#2A3A54"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderMutedBrush" Color="#C7D2FE"/>
    <SolidColorBrush x:Key="HeaderAccentBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="BtnSecondaryBg" Color="#223047"/>
    <SolidColorBrush x:Key="BtnSecondaryBorder" Color="#64748B"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#53657F"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#4F8CFF"/>

    <!-- Calendar popup (system keys used by default Calendar template) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#182235"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#182235"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4F8CFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#24324A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F8FAFC"/>
</ResourceDictionary>
